---
// SPDX-License-Identifier: AGPL-3.0-or-later
// Repos & Profiles management page — SSR fetch from FastAPI W1
import AdminLayout from '../../layouts/AdminLayout.astro';
import RepoTable from '../../components/RepoTable.astro';
import JobStatus from '../../components/JobStatus.astro';
import ProfileTree from '../../components/ProfileTree.astro';
import { FASTAPI_BASE } from '../../lib/fastapi';
import { privateAncestorOfShared, visibilityLabel, type TenantNames } from '../../lib/profileVisibility';

const cookieHeader = Astro.request.headers.get('cookie') ?? '';

// Repos come nested in /api/repos/profiles (there is no flat GET /api/repos/repos).
// /api/tenants is admin-only: a non-admin viewer gets no tenant names (badges
// then show the tenant id) and cannot create profiles anyway (admin route).
const [profilesRes, sshKeysRes, versionsRes, tenantsRes] = await Promise.allSettled([
  fetch(`${FASTAPI_BASE}/api/repos/profiles`, { headers: { cookie: cookieHeader } }),
  fetch(`${FASTAPI_BASE}/api/repos/ssh-keys-list`, { headers: { cookie: cookieHeader } }),
  fetch(`${FASTAPI_BASE}/api/versions`, { headers: { cookie: cookieHeader } }),
  fetch(`${FASTAPI_BASE}/api/tenants`, { headers: { cookie: cookieHeader } }),
]);

let profilesData: { profiles: unknown[]; all_job_id?: number | null; all_job_status?: string | null; error?: string | null } = { profiles: [] };
let repos: unknown[] = [];
let sshKeys: { id: number; name: string }[] = [];
let odooVersions: string[] = [];
let tenants: { id: number; name: string }[] = [];

if (profilesRes.status === 'fulfilled' && profilesRes.value.ok) {
  profilesData = await profilesRes.value.json();
}
if (sshKeysRes.status === 'fulfilled' && sshKeysRes.value.ok) {
  sshKeys = await sshKeysRes.value.json();
}
if (versionsRes.status === 'fulfilled' && versionsRes.value.ok) {
  const vd = await versionsRes.value.json();
  odooVersions = Array.isArray(vd.versions) ? (vd.versions as string[]) : [];
}

if (tenantsRes.status === 'fulfilled' && tenantsRes.value.ok) {
  const td = await tenantsRes.value.json();
  tenants = Array.isArray(td.tenants) ? (td.tenants as { id: number; name: string }[]) : [];
}
const tenantNames: TenantNames = Object.fromEntries(tenants.map((t) => [t.id, t.name]));
// Default series for a new root profile: the newest registered one (data-driven,
// /api/versions reads the profiles registry - 20.0 appears once odoo_20 exists).
const latestVersion = odooVersions.length > 0 ? odooVersions[odooVersions.length - 1] : '';

type ProfileRow = {
  id: number; name: string; odoo_version: string; description?: string;
  repos?: unknown[]; parent_profile_id?: number | null; tenant_id?: number | null;
};
const profileRows = profilesData.profiles as ProfileRow[];

for (const p of profilesData.profiles as { repos?: unknown[] }[]) {
  if (p.repos) repos = [...repos, ...p.repos];
}
---

<AdminLayout title="Repositories — Admin">
  <!-- Flash banner -->
  <div data-testid="flash-banner" hidden class="fixed top-4 right-4 z-50 px-5 py-3 rounded-xl shadow-lg text-sm font-medium border"></div>

  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">Repositories</h1>
      <p class="text-sm text-gray-500 mt-1">Manage profiles and their repositories</p>
    </div>
  </div>

  <!-- Add Profile Form -->
  <div class="bg-white rounded-xl border border-gray-200 p-5 mb-6 shadow-sm">
    <h2 class="text-base font-semibold text-gray-800 mb-4">Add Profile</h2>
    <p class="text-xs text-gray-500 mb-3">
      Pick the parent first: a child inherits its parent's Odoo version, and a child of a
      private profile inherits its tenant. A profile is never more visible than its parent.
    </p>
    <form data-testid="add-profile-form" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1" for="new-profile-parent">Parent profile</label>
        <select
          id="new-profile-parent"
          name="parent_id"
          data-testid="profile-parent-input"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
        >
          <option value="">- none (root profile) -</option>
          {profileRows.map((p) => (
            <option
              value={String(p.id)}
              data-version={p.odoo_version}
              data-tenant-id={p.tenant_id == null ? '' : String(p.tenant_id)}
            >{p.name} ({p.odoo_version}, {visibilityLabel(p, tenantNames)})</option>
          ))}
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1" for="new-profile-version">Odoo Version</label>
        <select
          id="new-profile-version"
          name="version"
          data-testid="profile-version-input"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
        >
          {odooVersions.map((v) => (
            <option value={v} selected={v === latestVersion}>{v}</option>
          ))}
          <option value="__other__" selected={odooVersions.length === 0}>Other (new series)...</option>
        </select>
        <input
          name="version_other"
          type="text"
          placeholder="e.g. 21.0"
          data-testid="profile-version-other-input"
          aria-label="New Odoo version"
          class="w-full mt-2 border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
          hidden={odooVersions.length > 0}
        />
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1" for="new-profile-tenant">Owner (tenant)</label>
        <select
          id="new-profile-tenant"
          name="tenant"
          data-testid="profile-tenant-input"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
        >
          <option value="">- choose the owner -</option>
          {tenants.map((t) => (
            <option value={String(t.id)}>{t.name}</option>
          ))}
          <option value="__shared__">Shared - every API key can read it (Odoo CE/EE base only)</option>
        </select>
        <p data-testid="profile-tenant-hint" class="text-xs text-gray-500 mt-1" hidden></p>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1" for="new-profile-name">Name</label>
        <input
          id="new-profile-name"
          name="name"
          type="text"
          placeholder="viindoo_internal_20"
          pattern="[a-zA-Z0-9_]{1,50}"
          title="1-50 letters, digits or underscores"
          data-testid="profile-name-input"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
          required
        />
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-600 mb-1" for="new-profile-description">Description</label>
        <input
          id="new-profile-description"
          name="description"
          type="text"
          data-testid="profile-description-input"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
        />
      </div>
      <div class="flex items-end">
        <button
          type="submit"
          data-testid="add-profile-button"
          class="w-full bg-viindoo-primary hover:bg-viindoo-primary-bright text-viindoo-bg-0 text-sm font-medium px-4 py-2 rounded-lg transition-colors"
        >
          Add Profile
        </button>
      </div>
    </form>
  </div>

  <!-- Profiles list -->
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mb-6">
    <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-base font-semibold text-gray-800">
        Profiles ({profilesData.profiles.length})
      </h2>
      {profilesData.profiles.length > 0 && (
        <button
          id="profile-view-toggle"
          data-testid="profile-view-toggle"
          class="text-xs border border-gray-300 rounded-lg px-3 py-1.5 text-gray-600 hover:bg-gray-50 transition-colors"
          aria-label="Switch profile view mode"
        >
          Switch to tree view
        </button>
      )}
    </div>

    {profilesData.profiles.length === 0 ? (
      <div data-testid="profiles-empty-state" class="py-12 text-center text-gray-500">
        <p class="text-3xl mb-2">🗂️</p>
        <p class="font-medium">No profiles configured.</p>
        <p class="text-sm mt-1">Add a profile above to get started.</p>
      </div>
    ) : (
      <>
        <!-- Flat list view (default) -->
        <div id="profile-flat-list" class="divide-y divide-gray-100">
          {profileRows.map((p) => {
            const leakAncestor = privateAncestorOfShared(p, profileRows);
            return (
            <div data-testid="profile-row" data-testid-id={`profile-row-${p.id}`} class="px-5 py-4 hover:bg-gray-50">
              <div class="flex items-center justify-between">
                <div>
                  <p class="font-medium text-gray-800">
                    {p.name}
                    <span
                      data-testid="profile-visibility-badge"
                      class={`ml-2 align-middle text-xs font-normal px-2 py-0.5 rounded-full ${p.tenant_id == null ? 'bg-amber-100 text-amber-800' : 'bg-gray-100 text-gray-700'}`}
                    >{visibilityLabel(p, tenantNames)}</span>
                  </p>
                  <p class="text-xs text-gray-500 mt-0.5">Odoo {p.odoo_version}{p.description ? ` — ${p.description}` : ''}</p>
                  {leakAncestor && (
                    <p data-testid="profile-visibility-warning" class="text-xs text-red-700 mt-1">
                      Shared with every key, but its ancestor {leakAncestor.name} is private: assign
                      this profile to {visibilityLabel(leakAncestor, tenantNames).replace('Private: ', '')} on the Tenants page.
                    </p>
                  )}
                </div>
                <div class="flex items-center gap-3 flex-wrap">
                  <span class="text-sm text-gray-500">{p.repos?.length ?? 0} repos</span>

                  <!-- Parent profile dropdown -->
                  <select
                    data-testid="profile-parent-select"
                    data-profile-id={String(p.id)}
                    class="text-xs border border-gray-300 rounded-lg px-2 py-1.5 text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep profile-parent-select"
                    title="Set parent profile"
                  >
                    <option value="">— no parent —</option>
                    {profileRows
                      .filter((other) => other.id !== p.id && other.odoo_version === p.odoo_version)
                      .map((other) => (
                        <option value={String(other.id)} selected={p.parent_profile_id === other.id}>{other.name}</option>
                      ))
                    }
                  </select>

                  <!-- Clone all pending button -->
                  <button
                    data-testid="clone-all-button"
                    data-profile-id={String(p.id)}
                    class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 px-3 py-1.5 rounded-lg transition-colors clone-all-btn"
                  >
                    Clone all pending
                  </button>

                  <button
                    data-testid={`edit-profile-button-${p.id}`}
                    data-profile-id={String(p.id)}
                    class="text-xs bg-yellow-50 hover:bg-yellow-100 text-yellow-700 px-3 py-1.5 rounded-lg transition-colors edit-profile-btn"
                  >
                    Edit
                  </button>

                  <button
                    data-testid={`delete-profile-button-${p.id}`}
                    data-profile-id={String(p.id)}
                    class="text-xs bg-red-50 hover:bg-red-100 text-red-700 px-3 py-1.5 rounded-lg transition-colors delete-profile-btn"
                  >
                    Delete
                  </button>
                </div>
              </div>

              <!-- Inline Edit Profile form (hidden until Edit button is clicked) -->
              <div
                data-testid={`edit-profile-form-${p.id}`}
                data-profile-id={String(p.id)}
                class="mt-3 p-3 border border-yellow-200 rounded-lg bg-yellow-50 edit-profile-form"
                hidden
              >
                <form class="grid grid-cols-1 sm:grid-cols-3 gap-3 items-end edit-profile-inner-form" data-profile-id={String(p.id)}>
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Name</label>
                    <input
                      name="name"
                      type="text"
                      value={p.name}
                      class="w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-yellow-400"
                      required
                    />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Odoo Version</label>
                    <input
                      name="version"
                      type="text"
                      value={p.odoo_version}
                      class="w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-yellow-400"
                      required
                    />
                  </div>
                  <div>
                    <label class="block text-xs font-medium text-gray-600 mb-1">Description</label>
                    <input
                      name="description"
                      type="text"
                      value={p.description ?? ''}
                      class="w-full border border-gray-300 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-yellow-400"
                    />
                  </div>
                  <p class="sm:col-span-3 text-xs text-gray-600">
                    Owner: {visibilityLabel(p, tenantNames)}. Change it on the
                    <a href="/admin/tenants" class="underline">Tenants page</a> (its repos follow).
                  </p>
                  <div class="sm:col-span-3 flex gap-2 justify-end">
                    <button
                      type="button"
                      class="text-xs px-3 py-1.5 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 transition-colors cancel-edit-profile-btn"
                      data-profile-id={String(p.id)}
                    >Cancel</button>
                    <button
                      type="submit"
                      class="text-xs bg-yellow-500 hover:bg-yellow-600 text-gray-900 px-3 py-1.5 rounded-lg transition-colors"
                    >Save</button>
                  </div>
                </form>
              </div>

              <!-- JobStatus widget for clone-all (hidden until a job is triggered) -->
              <div
                data-testid={`clone-all-status-${p.id}`}
                data-profile-id={String(p.id)}
                class="mt-2"
                hidden
              >
                <JobStatus jobId={null} autoPoll={false} testid={`clone-all-job-${p.id}`} />
              </div>
            </div>
            );
          })}
        </div>

        <!-- Tree view (hidden by default; toggled by JS) -->
        <div id="profile-tree-view" hidden>
          <ProfileTree profiles={profileRows} tenantNames={tenantNames} />
        </div>
      </>
    )}
  </div>

  <!-- Repo table component -->
  <RepoTable
    repos={repos as Parameters<typeof RepoTable>[0]['repos']}
    profiles={profilesData.profiles as Parameters<typeof RepoTable>[0]['profiles']}
    sshKeys={sshKeys}
    odooVersions={odooVersions}
  />
</AdminLayout>

<script>
  import { submitJson } from '../../lib/apiClient';
  import { flash } from '../../lib/flash';
  import { extractApiError } from '../../lib/apiError';

  // Add profile - parent -> version -> owner. A child inherits the parent's
  // version (locked) and, under a private parent, its tenant (locked); the
  // server enforces the same rule (422), this only keeps the form honest.
  const addForm = document.querySelector('[data-testid="add-profile-form"]') as HTMLFormElement | null;
  const parentSel = addForm?.querySelector('[data-testid="profile-parent-input"]') as HTMLSelectElement | null;
  const versionSel = addForm?.querySelector('[data-testid="profile-version-input"]') as HTMLSelectElement | null;
  const versionOther = addForm?.querySelector('[data-testid="profile-version-other-input"]') as HTMLInputElement | null;
  const tenantSel = addForm?.querySelector('[data-testid="profile-tenant-input"]') as HTMLSelectElement | null;
  const tenantHint = addForm?.querySelector('[data-testid="profile-tenant-hint"]') as HTMLElement | null;

  function syncVersionOther() {
    if (!versionSel || !versionOther) return;
    versionOther.hidden = versionSel.value !== '__other__';
  }

  function syncFromParent() {
    if (!parentSel || !versionSel || !tenantSel || !tenantHint) return;
    const opt = parentSel.selectedOptions[0];
    const parentVersion = parentSel.value ? opt?.dataset.version ?? '' : '';
    const parentTenant = parentSel.value ? opt?.dataset.tenantId ?? '' : '';
    if (parentVersion) {
      if (![...versionSel.options].some((o) => o.value === parentVersion)) {
        versionSel.add(new Option(parentVersion, parentVersion), 0);
      }
      versionSel.value = parentVersion;
    }
    versionSel.disabled = Boolean(parentVersion);
    syncVersionOther();
    if (parentTenant) {
      tenantSel.value = parentTenant;
      tenantSel.disabled = true;
      tenantHint.textContent = 'Inherited from the private parent profile.';
      tenantHint.hidden = false;
    } else {
      tenantSel.disabled = false;
      tenantHint.hidden = true;
    }
  }

  parentSel?.addEventListener('change', syncFromParent);
  versionSel?.addEventListener('change', syncVersionOther);

  addForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(addForm);
    const version = versionSel?.value === '__other__'
      ? (versionOther?.value ?? '').trim()
      : (versionSel?.value ?? '');
    const parentId = parentSel?.value ? Number(parentSel.value) : null;
    const owner = tenantSel?.value ?? '';
    const inherited = Boolean(tenantSel?.disabled);
    const body: Record<string, unknown> = {
      name: String(fd.get('name') ?? '').trim(),
      version,
      description: String(fd.get('description') ?? '').trim(),
      parent_id: parentId,
    };
    if (!inherited) {
      if (owner === '') {
        flash('Choose the owner tenant, or Shared for an Odoo CE/EE base profile.', { error: true });
        return;
      }
      if (owner === '__shared__') {
        if (!confirm(
          'Create a SHARED profile? Every API key, including free-tier keys, will be able '
          + 'to read its modules and repos. Only Odoo CE/EE base profiles should be shared.',
        )) return;
        body.shared = true;
      } else {
        body.tenant_id = Number(owner);
      }
    }
    const r = await submitJson('/api/repos/profiles', { method: 'POST', body });
    if (r.ok) {
      flash('Profile created.');
      setTimeout(() => location.reload(), 800);
    } else {
      flash(extractApiError(r.data, r.error ?? 'Failed to create profile.'), { error: true });
    }
  });

  // Parent profile dropdown — PATCH /api/repos/profiles/{id}/parent
  document.querySelectorAll('.profile-parent-select').forEach((sel) => {
    sel.addEventListener('change', async () => {
      const select = sel as HTMLSelectElement;
      const profileId = (select as HTMLElement).dataset.profileId;
      const parentId = select.value ? Number(select.value) : null;
      const r = await submitJson(`/api/repos/profiles/${profileId}/parent`, {
        method: 'PATCH',
        body: { parent_id: parentId },
      });
      if (r.ok) {
        flash('Parent updated.');
      } else if (r.status === 404) {
        flash(extractApiError(r.data, 'Profile not found.'), { error: true });
      } else if (r.status === 422) {
        flash(extractApiError(r.data, 'Validation error.'), { error: true });
      } else if (r.status === 400) {
        flash(extractApiError(r.data, 'Invalid parent selection.'), { error: true });
      } else {
        flash(extractApiError(r.data, 'Failed to update parent.'), { error: true });
      }
    });
  });

  // Clone all pending — POST /api/repos/profiles/{id}/clone-all
  document.querySelectorAll('.clone-all-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const profileId = (btn as HTMLElement).dataset.profileId;
      (btn as HTMLButtonElement).disabled = true;

      const r = await submitJson(`/api/repos/profiles/${profileId}/clone-all`, { method: 'POST', body: {} });
      const data = r.data as { total?: number; spawned?: number; short_circuited?: number };

      if (r.ok) {
        const total: number = data.total ?? 0;
        if (total === 0) {
          flash('No pending repos to clone.');
          (btn as HTMLButtonElement).disabled = false;
          return;
        }
        flash(`Clone-all started: ${total} repo(s) processing.`);

        // Show the JobStatus widget for this profile
        const statusDiv = document.querySelector(
          `[data-testid="clone-all-status-${profileId}"]`
        ) as HTMLElement | null;
        if (statusDiv) {
          statusDiv.removeAttribute('hidden');
          // Update the inner JobStatus badge text with summary
          const badge = statusDiv.querySelector('[data-testid^="clone-all-job-"]') as HTMLElement | null;
          if (badge) {
            badge.textContent = `Spawned: ${data.spawned ?? 0}, Short-circuited: ${data.short_circuited ?? 0}`;
            badge.removeAttribute('hidden');
          }
        }
      } else if (r.status === 404) {
        flash('Profile not found.', { error: true });
      } else {
        flash(extractApiError(r.data, 'Clone-all failed.'), { error: true });
      }
      (btn as HTMLButtonElement).disabled = false;
    });
  });

  // Edit profile — toggle inline form
  document.querySelectorAll('.edit-profile-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const profileId = (btn as HTMLElement).dataset.profileId;
      const formDiv = document.querySelector(
        `[data-testid="edit-profile-form-${profileId}"]`
      ) as HTMLElement | null;
      if (!formDiv) return;
      const hidden = formDiv.hasAttribute('hidden');
      if (hidden) {
        // Reset to the SSR-baked `value=` (committed DB state) before showing,
        // so uncommitted edits left over from a prior Cancel/reopen never
        // resurface and falsely imply they were saved.
        (formDiv.querySelector('.edit-profile-inner-form') as HTMLFormElement | null)?.reset();
        formDiv.removeAttribute('hidden');
      } else {
        formDiv.setAttribute('hidden', '');
      }
    });
  });

  // Cancel edit — hide AND reset so discarded input doesn't persist to reopen.
  document.querySelectorAll('.cancel-edit-profile-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const profileId = (btn as HTMLElement).dataset.profileId;
      const formDiv = document.querySelector(
        `[data-testid="edit-profile-form-${profileId}"]`
      ) as HTMLElement | null;
      (formDiv?.querySelector('.edit-profile-inner-form') as HTMLFormElement | null)?.reset();
      formDiv?.setAttribute('hidden', '');
    });
  });

  // Submit edit profile form — PATCH /api/repos/profiles/{id}
  document.querySelectorAll('.edit-profile-inner-form').forEach((formEl) => {
    formEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = formEl as HTMLFormElement;
      const profileId = (formEl as HTMLElement).dataset.profileId;
      const fd = new FormData(form);
      const payload: Record<string, string> = {
        name: (fd.get('name') as string).trim(),
        version: (fd.get('version') as string).trim(),
        description: (fd.get('description') as string).trim(),
      };

      const r = await submitJson(`/api/repos/profiles/${profileId}`, {
        method: 'PATCH',
        body: payload,
      });

      if (r.ok) {
        flash('Profile updated.');
        setTimeout(() => location.reload(), 800);
      } else {
        // Save was rejected (404 not-found / 409 name conflict / 422 version
        // mismatch per ADR-0024, or any other non-2xx). The DB was NOT mutated,
        // so reset the inputs back to their SSR-baked `value=` attributes — the
        // last committed DB state — instead of leaving the rejected edit on
        // screen, which would falsely imply the rename/version change stuck.
        form.reset();
        if (r.status === 404) {
          flash(extractApiError(r.data, 'Profile not found.'), { error: true });
        } else if (r.status === 409) {
          flash(extractApiError(r.data, 'Name already taken by another profile.'), { error: true });
        } else if (r.status === 422) {
          flash(extractApiError(r.data, 'Version conflicts with a descendant profile.'), { error: true });
        } else {
          flash(extractApiError(r.data, 'Failed to update profile.'), { error: true });
        }
      }
    });
  });

  // Delete profile
  document.querySelectorAll('.delete-profile-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const profileId = (btn as HTMLElement).dataset.profileId;
      if (!confirm('Delete this profile and ALL its repos? This cannot be undone.')) return;
      const r = await submitJson(`/api/repos/profiles/${profileId}`, { method: 'DELETE', body: {} });
      if (r.ok) {
        flash('Profile deleted.');
        setTimeout(() => location.reload(), 800);
      } else {
        flash(r.error!, { error: true });
      }
    });
  });

  // ── Profile view toggle (flat list ↔ tree view) ────────────────────────────
  // localStorage key: 'osm-profile-view' — values: 'flat' | 'tree'
  const STORAGE_KEY = 'osm-profile-view';

  const toggleBtn = document.getElementById('profile-view-toggle') as HTMLButtonElement | null;
  const flatList = document.getElementById('profile-flat-list') as HTMLElement | null;
  const treeView = document.getElementById('profile-tree-view') as HTMLElement | null;

  function applyViewMode(mode: 'flat' | 'tree') {
    if (!flatList || !treeView || !toggleBtn) return;
    if (mode === 'tree') {
      flatList.setAttribute('hidden', '');
      treeView.removeAttribute('hidden');
      toggleBtn.textContent = 'Switch to flat list';
    } else {
      treeView.setAttribute('hidden', '');
      flatList.removeAttribute('hidden');
      toggleBtn.textContent = 'Switch to tree view';
    }
  }

  // Restore saved preference on page load
  const savedMode = localStorage.getItem(STORAGE_KEY) as 'flat' | 'tree' | null;
  if (savedMode === 'tree') {
    applyViewMode('tree');
  }

  // Toggle on click
  toggleBtn?.addEventListener('click', () => {
    const isTree = !treeView?.hasAttribute('hidden');
    const nextMode: 'flat' | 'tree' = isTree ? 'flat' : 'tree';
    localStorage.setItem(STORAGE_KEY, nextMode);
    applyViewMode(nextMode);
  });
</script>
