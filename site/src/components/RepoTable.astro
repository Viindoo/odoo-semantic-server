---
// SPDX-License-Identifier: AGPL-3.0-or-later
import { formatTimestamp, repoIndexState, type IndexRun } from '../lib/jobs';

export interface Repo {
  id: number;
  url: string;
  branch: string;
  local_path: string | null;  // null for non-admin viewers (server path)
  odoo_version?: string;
  clone_status?: string;
  clone_error_msg?: string | null;
  status?: string | null;
  error_msg?: string | null;
  last_indexed_at?: string | null;
  head_sha?: string | null;
  index_run?: IndexRun | null;
}

export interface Profile {
  id: number;
  name: string;
  odoo_version?: string;
  description?: string;
  repos?: Repo[];
}

export interface SshKey {
  id: number;
  name: string;
}

export interface Props {
  repos: Repo[];
  profiles: Profile[];
  sshKeys: SshKey[];
  odooVersions?: string[];
}

const { repos = [], profiles = [], sshKeys = [], odooVersions = [] } = Astro.props;
// Default selection: latest version (last in numeric-sorted list from /api/versions)
const latestVersion = odooVersions.length > 0 ? odooVersions[odooVersions.length - 1] : '';

const cloneStatusColor: Record<string, string> = {
  manual:  'bg-gray-100 text-gray-600',
  pending: 'bg-yellow-100 text-yellow-700',
  cloned:  'bg-green-100 text-green-700',
  error:   'bg-red-100 text-red-700',
};

const indexBadge: Record<string, string> = {
  indexing:    'bg-viindoo-info/10 text-viindoo-info',
  indexed:     'bg-green-100 text-green-700',
  failed:      'bg-red-100 text-red-700',
  not_indexed: 'bg-gray-100 text-gray-600',
};

// Helper to truncate long error messages
function truncate(text: string | null | undefined, maxLen: number): string {
  if (!text) return '';
  return text.length > maxLen ? text.substring(0, maxLen) + '…' : text;
}
---

<!-- Add Repo Form -->
<div class="bg-white rounded-xl border border-gray-200 p-5 mb-6 shadow-sm">
  <h2 class="text-base font-semibold text-gray-800 mb-4">Add Repository</h2>
  <form data-testid="add-repo-form" data-repo-form class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">Profile</label>
      <select
        name="profile"
        data-testid="repos-profile-input"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
        required
      >
        <option value="">— select profile —</option>
        {profiles.map((p) => (
          <option value={p.name} data-version={p.odoo_version ?? ''}>{p.name} ({p.odoo_version})</option>
        ))}
      </select>
    </div>
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">URL</label>
      <input
        name="url"
        type="text"
        placeholder="https://... or git@..."
        data-testid="repos-url-input"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
        required
      />
    </div>
    <!-- W4 B: version select — pre-fills branch; no name so not submitted separately -->
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">Odoo Version (suggests branch)</label>
      <select
        data-testid="repos-version-select"
        id="repo-version-select"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
      >
        {odooVersions.length === 0 ? (
          <option value="">— no versions available —</option>
        ) : (
          odooVersions.map((v) => (
            <option value={v} selected={v === latestVersion}>{v}</option>
          ))
        )}
      </select>
    </div>
    <!-- W4 D: branch pre-filled from version select; user can override -->
    <div>
      <label class="block text-xs font-medium text-gray-600 mb-1">Branch</label>
      <input
        name="branch"
        type="text"
        placeholder={latestVersion || "17.0"}
        data-testid="repos-branch-input"
        id="repo-branch-input"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
        required
      />
    </div>
    <div data-testid="ssh-key-select-wrapper" hidden>
      <label class="block text-xs font-medium text-gray-600 mb-1">SSH Key (for git@ URLs)</label>
      <select
        name="ssh_key_id"
        data-testid="repos-ssh-key-input"
        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
      >
        <option value="">— none —</option>
        {sshKeys.map((k) => (
          <option value={String(k.id)}>{k.name}</option>
        ))}
      </select>
    </div>
    <div class="flex items-end">
      <button
        type="submit"
        data-testid="add-repo-button"
        class="w-full bg-viindoo-primary hover:bg-viindoo-primary-bright text-viindoo-bg-0 text-sm font-medium px-4 py-2 rounded-lg transition-colors"
      >
        Add Repository
      </button>
    </div>
  </form>
</div>

<!-- Repos Table -->
<div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
  <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between gap-3">
    <h2 class="text-base font-semibold text-gray-800">Repositories ({repos.length})</h2>
    {repos.length > 0 && (
      <div class="flex flex-wrap items-center gap-2">
        <!-- W4 C: worker controls -->
        <label class="flex items-center gap-1 text-xs text-gray-600">
          <span class="whitespace-nowrap">Profile workers:</span>
          <input
            type="number"
            min="1"
            max="4"
            value="1"
            data-testid="index-all-profile-workers"
            class="w-14 border border-gray-300 rounded px-1.5 py-1 text-xs text-center focus:outline-none focus:ring-1 focus:ring-viindoo-info"
            title="Parallel profiles (1–4)"
          />
        </label>
        <label class="flex items-center gap-1 text-xs text-gray-600">
          <span class="whitespace-nowrap">Max workers:</span>
          <input
            type="number"
            min="1"
            max="8"
            value="1"
            data-testid="index-all-max-workers"
            class="w-14 border border-gray-300 rounded px-1.5 py-1 text-xs text-center focus:outline-none focus:ring-1 focus:ring-viindoo-info"
            title="Repo-level workers per profile (1–8)"
          />
        </label>
        <label class="flex items-center gap-1.5 text-xs text-gray-600">
          <input
            type="checkbox"
            data-testid="index-all-full-checkbox"
            class="w-4 h-4 rounded border-gray-300 text-viindoo-info focus:ring-2 focus:ring-viindoo-info"
            title="Force full reindex: re-parse every module (backfills new index-time properties). Not needed to remove renamed or deleted modules: that runs on every index run (ADR-0056)"
          />
          <span>Full reindex</span>
        </label>
        <button
          data-testid="index-all-button"
          class="text-sm bg-viindoo-info hover:bg-viindoo-primary text-viindoo-bg-0 px-4 py-1.5 rounded-lg transition-colors"
        >
          Index All
        </button>
      </div>
    )}
  </div>

  {repos.length === 0 ? (
    <div data-testid="repos-empty-state" class="py-16 text-center text-gray-500">
      <p class="text-4xl mb-3">📦</p>
      <p class="font-medium">No repositories added yet.</p>
      <p class="text-sm mt-1">Add one using the form above.</p>
    </div>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
          <tr>
            <th class="px-4 py-3 text-left">Repo / Branch</th>
            <th class="px-4 py-3 text-left">Profile</th>
            <th class="px-4 py-3 text-left">Local Path (server-managed)</th>
            <th class="px-4 py-3 text-left">Clone</th>
            <th class="px-4 py-3 text-left" title="This repository's own indexing state, from every index run (Web UI, CLI or scheduled)">Index status</th>
            <th class="px-4 py-3 text-left" title="CoreSymbol count in graph (0 = core API not indexed for this version)">Core Index</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {repos.map((repo) => {
            const cloneClass = cloneStatusColor[repo.clone_status ?? 'manual'] ?? cloneStatusColor.manual;
            const profileName = profiles.find((p) => p.repos?.some((r) => r.id === repo.id))?.name ?? '';
            const state = repoIndexState(repo);
            return (
              <tr data-testid="repo-row" data-testid-id={`repo-row-${repo.id}`} class="hover:bg-gray-50">
                <td class="px-4 py-3">
                  <p class="font-medium text-gray-800 truncate max-w-xs" title={repo.url}>{repo.url}</p>
                  <p class="text-gray-500 text-xs mt-0.5">{repo.branch}</p>
                </td>
                <td class="px-4 py-3 text-gray-600">
                  {profileName || '-'}
                </td>
                <td class="px-4 py-3">
                  <p
                    class="text-xs text-gray-500 font-mono truncate max-w-xs"
                    title={repo.local_path}
                    data-testid={`repo-local-path-${repo.id}`}
                  >
                    {repo.local_path || '—'}
                  </p>
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-col gap-1">
                    <span class:list={['px-2 py-0.5 rounded-full text-xs font-medium', cloneClass]}>
                      {repo.clone_status ?? 'manual'}
                    </span>
                    {repo.clone_status === 'error' && repo.clone_error_msg && (
                      <span class="text-red-700 text-xs" title={repo.clone_error_msg}>
                        {truncate(repo.clone_error_msg, 100)}
                      </span>
                    )}
                    {(repo.clone_status === 'error' || repo.clone_status === 'pending') && (
                      <details class="text-xs clone-log" data-repo-id={String(repo.id)} data-testid={`repo-clone-log-${repo.id}`}>
                        <summary class="cursor-pointer text-gray-600">Clone log</summary>
                        <p class="mt-1 text-gray-500 font-mono break-all" data-clone-log-path></p>
                        <pre class="mt-1 max-h-64 overflow-auto whitespace-pre-wrap break-words font-mono bg-gray-900 text-gray-100 rounded p-2" data-clone-log>Loading log...</pre>
                      </details>
                    )}
                  </div>
                </td>
                <td class="px-4 py-3" data-testid={`repo-index-status-${repo.id}`} data-state={state.kind}>
                  <div class="flex flex-col gap-1 max-w-xs">
                    <span class:list={['self-start px-2 py-0.5 rounded-full text-xs font-medium', indexBadge[state.kind]]}>
                      {state.label}
                    </span>
                    {state.kind === 'indexing' && (
                      <span class="text-xs text-gray-600">
                        by {state.jobId !== null ? (
                          <a
                            href={`/admin/operations#job-${state.jobId}`}
                            class="text-viindoo-info underline"
                            data-index-job={String(state.jobId)}
                            data-testid={`repo-index-job-${repo.id}`}
                          >{state.runText}</a>
                        ) : state.runText}
                      </span>
                    )}
                    {state.kind === 'indexing' && state.jobId !== null && (
                      <span class="text-xs text-gray-500 font-mono truncate" data-job-step={String(state.jobId)}></span>
                    )}
                    {state.kind === 'failed' && (
                      <details class="text-xs" data-testid={`repo-index-error-${repo.id}`}>
                        <summary class="cursor-pointer text-red-700">{truncate(state.error, 80)}</summary>
                        <pre class="mt-1 whitespace-pre-wrap break-words text-red-800 bg-red-50 rounded p-2">{state.error}</pre>
                      </details>
                    )}
                    {state.lastIndexedAt && (
                      <span class="text-xs text-gray-500">
                        {state.kind === 'indexed' ? '' : 'Last indexed '}{formatTimestamp(state.lastIndexedAt)}
                      </span>
                    )}
                    {state.note && (
                      <span class="text-xs text-amber-700" data-testid={`repo-index-note-${repo.id}`}>{state.note}</span>
                    )}
                  </div>
                </td>
                <td class="px-4 py-3">
                  <span
                    data-testid={`core-index-badge-${repo.id}`}
                    data-repo-id={String(repo.id)}
                    class="core-index-badge text-xs text-gray-400"
                  >—</span>
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <label class="flex items-center gap-1.5 text-xs text-gray-600" title="Force full reindex: re-parse every module (backfills new index-time properties). Not needed to remove renamed or deleted modules: that runs on every index run (ADR-0056)">
                      <input
                        type="checkbox"
                        data-testid={`index-repo-full-checkbox-${repo.id}`}
                        data-repo-id={String(repo.id)}
                        class="w-3.5 h-3.5 rounded border-gray-300 text-viindoo-info focus:ring-2 focus:ring-viindoo-info"
                      />
                    </label>
                    <button
                      data-testid={`index-repo-button-${repo.id}`}
                      data-repo-id={String(repo.id)}
                      title={`Index every repository of profile ${profileName} (one job for the whole profile)`}
                      class="text-xs bg-viindoo-info/10 hover:bg-viindoo-info/20 text-viindoo-info px-3 py-1.5 rounded-lg transition-colors whitespace-nowrap index-repo-btn"
                    >
                      Index profile
                    </button>
                    {repo.head_sha && (
                      <button
                        data-testid={`reset-embed-button-${repo.id}`}
                        data-repo-id={String(repo.id)}
                        class="text-xs bg-amber-50 hover:bg-amber-100 text-amber-700 px-3 py-1.5 rounded-lg transition-colors reset-embed-btn"
                      >
                        Reset
                      </button>
                    )}
                    <button
                      data-testid={`edit-repo-button-${repo.id}`}
                      data-repo-id={String(repo.id)}
                      class="text-xs bg-gray-50 hover:bg-gray-100 text-gray-700 px-3 py-1.5 rounded-lg transition-colors edit-repo-btn"
                    >
                      Edit
                    </button>
                    <button
                      data-testid={`delete-repo-button-${repo.id}`}
                      data-repo-id={String(repo.id)}
                      class="text-xs bg-red-50 hover:bg-red-100 text-red-700 px-3 py-1.5 rounded-lg transition-colors delete-repo-btn"
                    >
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
              <!-- Inline edit form row (hidden by default) -->
              <tr
                data-testid={`edit-repo-form-row-${repo.id}`}
                data-repo-id={String(repo.id)}
                class="edit-repo-form-row bg-blue-50"
                hidden
              >
                <td colspan="7" class="px-4 py-4">
                  <form
                    data-testid={`edit-repo-form-${repo.id}`}
                    data-edit-repo-form
                    data-repo-id={String(repo.id)}
                    class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"
                  >
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">URL</label>
                      <input
                        name="url"
                        type="text"
                        placeholder={repo.url}
                        data-testid={`edit-repo-url-${repo.id}`}
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
                      />
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">Branch</label>
                      <input
                        name="branch"
                        type="text"
                        placeholder={repo.branch}
                        data-testid={`edit-repo-branch-${repo.id}`}
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
                      />
                    </div>
                    <div>
                      <label class="block text-xs font-medium text-gray-600 mb-1">SSH Key</label>
                      <select
                        name="ssh_key_id"
                        data-testid={`edit-repo-ssh-key-${repo.id}`}
                        class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-viindoo-primary-deep"
                      >
                        <option value="">— unchanged —</option>
                        <option value="clear">— clear key —</option>
                        {sshKeys.map((k) => (
                          <option value={String(k.id)}>{k.name}</option>
                        ))}
                      </select>
                    </div>
                    <div class="sm:col-span-2 lg:col-span-3">
                      <label class="block text-xs font-medium text-gray-500 mb-1">
                        Local path (server-managed, read-only)
                      </label>
                      <p class="text-xs font-mono text-gray-500 px-3 py-2 bg-gray-100 rounded-lg border border-gray-200 truncate" title={repo.local_path}>
                        {repo.local_path || '—'}
                      </p>
                    </div>
                    <div class="sm:col-span-2 lg:col-span-3 flex gap-2 justify-end">
                      <button
                        type="button"
                        data-testid={`edit-repo-cancel-${repo.id}`}
                        data-repo-id={String(repo.id)}
                        class="text-xs px-4 py-2 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-100 transition-colors edit-repo-cancel-btn"
                      >
                        Cancel
                      </button>
                      <button
                        type="submit"
                        data-testid={`edit-repo-submit-${repo.id}`}
                        class="text-xs bg-viindoo-primary hover:bg-viindoo-primary-bright text-viindoo-bg-0 px-4 py-2 rounded-lg transition-colors"
                      >
                        Save changes
                      </button>
                    </div>
                  </form>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</div>

<script>
  import { submitJson } from '../lib/apiClient';
  import { flash } from '../lib/flash';
  import { isJobLive, lastLogLine } from '../lib/jobs';

  // Add repo form
  document.querySelector('[data-testid="add-repo-form"]')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const fd = new FormData(form);
    const body: Record<string, string> = {};
    fd.forEach((v, k) => { body[k] = String(v); });
    const r = await submitJson('/api/repos/repos', { method: 'POST', body });
    if (r.ok) {
      flash('Repository added.');
      setTimeout(() => location.reload(), 800);
    } else {
      flash(r.error!, { error: true });
    }
  });

  // Index repo buttons
  document.querySelectorAll('.index-repo-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const repoId = (btn as HTMLElement).dataset.repoId;
      const fullCheckbox = document.querySelector(`[data-testid="index-repo-full-checkbox-${repoId}"]`) as HTMLInputElement | null;
      const body: Record<string, string> = { max_workers: '1' };
      if (fullCheckbox?.checked) {
        body.full = '1';
      }
      const r = await submitJson(`/api/repos/repos/${repoId}/index`, { method: 'POST', body });
      const data = r.data as { job_id?: number | null; message?: string };
      if (r.ok) {
        // Started, or already covered by the profile's running job: either way
        // the rows now show it as Indexing.
        flash(data.message ?? `Index job #${data.job_id} started.`);
        setTimeout(() => location.reload(), 1200);
      } else {
        flash(r.error!, { error: true });
      }
    });
  });

  // Rows being indexed by a Web UI job: show its current step (the last log
  // line, admins only) and say when it ends, without reloading the page.
  function watchIndexJobs(): void {
    const links = Array.from(document.querySelectorAll<HTMLElement>('[data-index-job]'));
    const ids = [...new Set(links.map((a) => a.dataset.indexJob).filter(Boolean))] as string[];
    for (const id of ids) {
      const tick = async () => {
        const r = await submitJson<{ status?: string; log?: { tail?: string | null } | null }>(
          `/api/jobs/${id}/status`, { method: 'GET', stepUp: false },
        );
        if (!r.ok) return;
        const step = lastLogLine(r.data.log?.tail);
        document.querySelectorAll<HTMLElement>(`[data-job-step="${id}"]`).forEach((el) => {
          el.textContent = step ?? '';
          el.title = step ?? '';
        });
        if (isJobLive(r.data.status)) {
          setTimeout(tick, 5000);
          return;
        }
        document.querySelectorAll<HTMLElement>(`[data-index-job="${id}"]`).forEach((a) => {
          a.textContent = `job #${id} finished (${r.data.status}) - reload to see the result`;
        });
      };
      tick();
    }
  }
  watchIndexJobs();

  // Clone log of a failed or running clone (admins; GET .../clone-status `log`).
  document.querySelectorAll<HTMLDetailsElement>('details.clone-log').forEach((details) => {
    details.addEventListener('toggle', async () => {
      if (!details.open) return;
      const pathEl = details.querySelector('[data-clone-log-path]') as HTMLElement | null;
      const pre = details.querySelector('[data-clone-log]') as HTMLElement | null;
      if (!pre || !pathEl) return;
      const r = await submitJson<{ log?: { path: string; tail: string | null; truncated: boolean } | null }>(
        `/api/repos/repos/${details.dataset.repoId}/clone-status`, { method: 'GET', stepUp: false },
      );
      const log = r.ok ? r.data.log : null;
      if (!r.ok) {
        pathEl.textContent = '';
        pre.textContent = r.error ?? 'Could not read the clone status.';
      } else if (!log || log.tail === null) {
        pathEl.textContent = '';
        pre.textContent = log ? `No clone log for this repository (looked for ${log.path}).` : 'No log available.';
      } else {
        pathEl.textContent = `Log file on the server: ${log.path}`;
        pre.textContent = (log.truncated ? '[showing the end of the log]\n' : '') + (log.tail || '(empty)');
      }
    });
  });

  // Reset embed buttons
  document.querySelectorAll('.reset-embed-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const repoId = (btn as HTMLElement).dataset.repoId;
      if (!confirm('Reset embeddings and re-index this repo? This re-embeds all chunks and may take several minutes.')) return;
      const r = await submitJson(`/api/repos/repos/${repoId}/reset-embed`, { method: 'POST', body: {} });
      const data = r.data as { job_id?: number };
      if (r.ok) {
        flash(`Reset started (job #${data.job_id}).`);
      } else {
        flash(r.error!, { error: true });
      }
    });
  });

  // Delete repo buttons
  document.querySelectorAll('.delete-repo-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const repoId = (btn as HTMLElement).dataset.repoId;
      if (!confirm('Delete this repository? This cannot be undone.')) return;
      const r = await submitJson(`/api/repos/repos/${repoId}`, { method: 'DELETE', body: {} });
      if (r.ok) {
        flash('Repository deleted.');
        setTimeout(() => location.reload(), 800);
      } else {
        flash(r.error!, { error: true });
      }
    });
  });

  // Index all button - W4 C: read actual worker values
  document.querySelector('[data-testid="index-all-button"]')?.addEventListener('click', async () => {
    if (!confirm('Trigger index for ALL profiles?')) return;
    const fullCheckbox = document.querySelector('[data-testid="index-all-full-checkbox"]') as HTMLInputElement | null;
    const profileWorkersInput = document.querySelector('[data-testid="index-all-profile-workers"]') as HTMLInputElement | null;
    const maxWorkersInput = document.querySelector('[data-testid="index-all-max-workers"]') as HTMLInputElement | null;
    const body: Record<string, string> = {
      max_workers: maxWorkersInput?.value || '1',
      profile_workers: profileWorkersInput?.value || '1',
    };
    if (fullCheckbox?.checked) {
      body.full = '1';
    }
    const r = await submitJson('/api/repos/index-all', { method: 'POST', body });
    const data = r.data as { job_id?: number };
    if (r.ok) {
      flash(`Index-all job #${data.job_id} started.`);
    } else {
      flash(r.error!, { error: true });
    }
  });

  // W4 D: version select → branch input suggestion
  const versionSelect = document.querySelector('#repo-version-select') as HTMLSelectElement | null;
  const branchInput = document.querySelector('#repo-branch-input') as HTMLInputElement | null;
  if (versionSelect && branchInput) {
    // Set initial value from version select if branch is empty
    if (!branchInput.value && versionSelect.value) {
      branchInput.value = versionSelect.value;
    }
    versionSelect.addEventListener('change', () => {
      // Only update branch if user hasn't manually changed it
      // (we track this via a data attribute set on manual input)
      if (!branchInput.dataset.userEdited) {
        branchInput.value = versionSelect.value;
        branchInput.placeholder = versionSelect.value;
      }
    });
    branchInput.addEventListener('input', () => {
      // Mark as user-edited so auto-suggestion stops overwriting
      branchInput.dataset.userEdited = '1';
    });
    // A repo is indexed at its PROFILE's version: picking a profile selects
    // that version (and, unless typed over, the branch) so a 20.0 profile
    // never gets the newest-version default of another series.
    const profileSelect = document.querySelector('[data-testid="repos-profile-input"]') as HTMLSelectElement | null;
    profileSelect?.addEventListener('change', () => {
      const v = profileSelect.selectedOptions[0]?.dataset.version ?? '';
      if (!v) return;
      if (![...versionSelect.options].some((o) => o.value === v)) {
        versionSelect.add(new Option(v, v));
      }
      versionSelect.value = v;
      versionSelect.dispatchEvent(new Event('change'));
    });
  }

  // Edit repo buttons — toggle inline edit form row
  document.querySelectorAll('.edit-repo-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const repoId = (btn as HTMLElement).dataset.repoId;
      const formRow = document.querySelector(
        `[data-testid="edit-repo-form-row-${repoId}"]`
      ) as HTMLElement | null;
      if (formRow) {
        formRow.hidden = !formRow.hidden;
      }
    });
  });

  // Edit repo cancel buttons
  document.querySelectorAll('.edit-repo-cancel-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const repoId = (btn as HTMLElement).dataset.repoId;
      const formRow = document.querySelector(
        `[data-testid="edit-repo-form-row-${repoId}"]`
      ) as HTMLElement | null;
      if (formRow) formRow.hidden = true;
    });
  });

  // Edit repo form submit — PATCH /api/repos/repos/{id}
  document.querySelectorAll('[data-edit-repo-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = form as HTMLFormElement;
      const repoId = (form as HTMLElement).dataset.repoId;
      const fd = new FormData(f);

      const body: Record<string, unknown> = {};
      const urlVal = (fd.get('url') as string | null)?.trim();
      const branchVal = (fd.get('branch') as string | null)?.trim();
      const sshKeyVal = (fd.get('ssh_key_id') as string | null)?.trim();
      // local_path is server-managed — not sent in PATCH (WI-G)

      if (urlVal) body['url'] = urlVal;
      if (branchVal) body['branch'] = branchVal;
      if (sshKeyVal === 'clear') {
        body['clear_ssh_key'] = true;
      } else if (sshKeyVal) {
        body['ssh_key_id'] = Number(sshKeyVal);
      }

      const r = await submitJson(`/api/repos/repos/${repoId}`, { method: 'PATCH', body });
      const data = r.data as { updated_fields?: string[] };

      if (r.ok) {
        const fields: string[] = data.updated_fields ?? [];
        flash(fields.length ? `Repo updated: ${fields.join(', ')}.` : 'No fields changed.');
        setTimeout(() => location.reload(), 800);
      } else {
        flash(r.error!, { error: true });
      }
    });
  });

  // Core Index badge — fetch CoreSymbol count per repo and render badge.
  // Called once on page load; gracefully degrades on Neo4j unavailability.
  async function loadCoreIndexBadges(): Promise<void> {
    const badges = document.querySelectorAll<HTMLElement>('.core-index-badge');
    await Promise.all(Array.from(badges).map(async (badge) => {
      const repoId = badge.dataset.repoId;
      if (!repoId) return;
      try {
        const r = await submitJson<{ counts?: Record<string, number> }>(`/api/repos/repos/${repoId}/core-symbol-counts`, { method: 'GET', stepUp: false });
        if (!r.ok) return;
        const counts: Record<string, number> = r.data.counts ?? {};
        const total = Object.values(counts).reduce((s, n) => s + n, 0);
        if (total > 0) {
          const parts = Object.entries(counts)
            .filter(([, n]) => n > 0)
            .map(([v, n]) => `${v}: ${n.toLocaleString()}`)
            .join(', ');
          badge.textContent = parts;
          badge.className = badge.className.replace('text-gray-400', 'text-green-700');
          badge.classList.add('font-medium');
        } else {
          badge.textContent = 'not indexed';
          badge.className = badge.className.replace('text-gray-400', 'text-amber-600');
        }
      } catch {
        // Neo4j unreachable — leave dash placeholder
      }
    }));
  }
  loadCoreIndexBadges();

  // SSH key dropdown toggle — show when URL starts with git@, hide otherwise.
  // Works for all repo-form elements (currently one add-repo-form on the page).
  document.querySelectorAll('[data-repo-form]').forEach((form) => {
    const urlInput = form.querySelector('input[name="url"]') as HTMLInputElement | null;
    const sshDiv = form.querySelector('[data-testid="ssh-key-select-wrapper"]') as HTMLElement | null;
    if (!urlInput || !sshDiv) return;
    const update = () => {
      const isSsh = urlInput.value.startsWith('git@');
      sshDiv.hidden = !isSsh;
    };
    urlInput.addEventListener('input', update);
    update();  // initial state on page load
  });
</script>
