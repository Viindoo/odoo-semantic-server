# odoo-semantic-reindex.service — systemd oneshot for periodic incremental reindex
# Đặt tại: /etc/systemd/system/odoo-semantic-reindex.service
# Companion timer: /etc/systemd/system/odoo-semantic-reindex.timer
#
# After copying both files:
#   sudo install -d -o odoo-semantic -g odoo-semantic /var/log/odoo-semantic   # nếu chưa có
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now odoo-semantic-reindex.timer
#
# Runs `index-repo --all` — M6 Wave 2 incremental: head_sha skip → zero-cost for
# unchanged repos; git diff filters scan to changed modules only. See ADR-0007.
#
# Module lifecycle (ADR-0056): every run of this unit also retires modules no
# repo ships any more (renamed, deleted, moved) with their subtree and
# embeddings, through the module_presence ledger and one reconcile per Odoo
# version. No flag is needed and nobody approves a deletion (ADR-0057 and its
# phase 2): retirement, the orphan and embedding sweeps, the entity prune and
# the shared-module prune delete what the git HEAD tree proves gone, whatever
# the count; what git cannot prove is kept and reported by lifecycle-audit
# (unproven_drops, kept orphans, parser_gaps), never an exit 3. A registered
# repo without a checkout is cloned by the run when its clone never succeeded
# (issue #383 item 2). Exit code 3 means the index was written but OSM cannot
# reflect part of the code by itself (an untrusted checkout, a total wipe that
# is not in the branch history, a graph missing Module nodes, an unparseable
# manifest, an undecidable name, a repo that still cannot be cloned, a failed
# reconcile, a repo whose fetch failed two runs in a row, a fetch failure for
# every repo of the run, the embedder down all run): OnFailure= fires; read the tail of the log and
# repos.lifecycle_attention (deploy.md s3.6). NEVER add --allow-mass-retire
# here or in a drop-in: it is an emergency bypass that also deletes what git
# cannot prove gone. Incident escape hatch: a temporary drop-in with
# --no-retire (scan + write, delete nothing).
#
# WHY a systemd timer (not a bare cron.d entry): the indexer reads PG_DSN +
# NEO4J_PASSWORD via config; a cron.d line does NOT load .env, so it would fail
# auth unless the secrets happen to live in odoo-semantic.conf. EnvironmentFile=
# here loads the same .env as the other units — creds guaranteed present.
#
# FERNET_KEY delivery (post-#355): since #355, `index-repo --all` runs
# `git fetch` + `reset --hard origin/<branch>` BEFORE scanning each clone
# (see src.indexer.pipeline_repo.refresh_before_scan, which calls
# src.git_utils.refresh_repo). Fetching a private SSH repo needs
# its stored SSH key decrypted via `src.crypto` - which requires FERNET_KEY.
# This unit runs as `odoo-semantic` (not root), so it cannot use the root-only
# `osm-fernet-run` wrapper (systemd-run -p LoadCredential=) the way ad-hoc CLI
# invocations do; instead FERNET_KEY is delivered directly via the systemd
# credential store, exactly like the odoo-semantic-webui.service and
# odoo-semantic-backup.service units (ADR-0020 / ADR-0035). PREREQUISITE:
# `/etc/credstore/FERNET_KEY` must exist (root:root 0600) BEFORE this line is
# active, or the unit hard-fails at startup with `status=243/CREDENTIALS`
# (NOT a soft fallback to EnvironmentFile=). Without
# FERNET_KEY, every SSH-scheme repo fails to fetch (logged WARNING, falls back
# to indexing on-disk state - see #355 fail-safe) - in practice this made the
# fetch-before-scan step inert, since all indexed repos in production are SSH.
# Operators who want an air-gapped/no-fetch nightly run can pass `--no-fetch`
# on ExecStart instead of provisioning the credential.
#
# There is no monthly `--full --gc` step any more: --gc is a deprecated no-op
# and --full is only a property backfill (deploy.md s3.6). Weekly drift
# detection: odoo-semantic-lifecycle-audit.timer.
#
# Override container/worker knobs via .env ($POSTGRES_CONTAINER, ...).
# Canonical layout = ADR-0027 (system-user odoo-semantic, /home/odoo-semantic/...).

[Unit]
Description=OSM periodic incremental reindex (index-repo --all)
# odoo-semantic-backup.service: the backup (23:30) normally ends ~13 min later,
# well before this run (00:00). Neo4j is exported online, so a run writing
# during the export leaves a bundle whose graph and PostgreSQL disagree.
# After= makes this start wait while a backup start job is queued or running
# when it starts (a slow night, a retry already under way); the backup's
# TimeoutStartSec bounds that wait. It does NOT wait during the backup's
# RestartSec gap after a failed attempt (no job exists then): this run starts,
# and the backup's ExecCondition= refuses the restarted attempt while this run
# is active (a failed backup, so OnFailure= reports the missed night). Ordering
# only; the run does not need the backup to succeed.
After=network-online.target docker.service odoo-semantic-backup.service
Wants=network-online.target
Requires=docker.service
StartLimitBurst=3
StartLimitIntervalSec=1800
OnFailure=osm-alert@%n

[Service]
Type=oneshot
User=odoo-semantic
Group=odoo-semantic
WorkingDirectory=/home/odoo-semantic/odoo-semantic-mcp
Environment="ODOO_SEMANTIC_CONF=/home/odoo-semantic/etc/odoo-semantic.conf"
# Loads PG_DSN + NEO4J_PASSWORD (+ optional $POSTGRES_CONTAINER) — same as the
# MCP/webui/backup units. This is what makes a periodic reindex viable off-cron.
EnvironmentFile=-/home/odoo-semantic/odoo-semantic-mcp/.env
# FERNET_KEY for decrypting stored SSH keys during the pre-scan `git fetch`
# (post-#355, see header comment above) - systemd credential store, same
# source as odoo-semantic-webui.service / odoo-semantic-backup.service.
# PREREQUISITE: /etc/credstore/FERNET_KEY must exist root:root 0600 BEFORE
# this line is active, or the unit hard-fails at status=243/CREDENTIALS.
LoadCredential=FERNET_KEY:/etc/credstore/FERNET_KEY
# Run-start marker in the log file: osm-alert@ (src.ops.alert_notify) reads only
# the lines after this invocation's marker, so a lifecycle block or tail from an
# earlier run is never reported as this run's. `$$` passes a literal `$` to sh.
ExecStartPre=/bin/sh -c 'echo "osm-run-start $(date -u +%%Y-%%m-%%dT%%H:%%M:%%SZ) invocation=$$INVOCATION_ID"'
# Pre-flight: wait up to 60s for Postgres (indexer needs PG + Neo4j reachable).
ExecStartPre=/bin/sh -c 'timeout 60 sh -c "until docker exec ${POSTGRES_CONTAINER:-odoo-semantic-mcp-postgres-1} pg_isready -U odoo_semantic -d odoo_semantic >/dev/null 2>&1; do sleep 2; done"'
# Refresh the alert hook's last known admin list (osm-alert@, used when the
# database is down; ignored once older than OSM_ALERT_ADMIN_CACHE_MAX_DAYS, so
# it must be refreshed even on nights nothing fails). Best effort: the leading
# `-` means it can never fail or hold the run; it sends no mail. The directory
# is osm-alert@'s StateDirectory (owned by odoo-semantic); before that unit
# first runs it does not exist and the refresh only logs a warning.
ExecStartPre=-/usr/bin/env OSM_ALERT_STATE_DIR=/var/lib/osm-alert /home/odoo-semantic/.venv/odoo-semantic-mcp/bin/python -m src.ops.alert_notify --refresh-admins
ExecStart=/home/odoo-semantic/.venv/odoo-semantic-mcp/bin/python -m src.indexer index-repo --all --profile-workers 2
# Incremental is usually fast, but a first/large run can be long — never kill it.
TimeoutStartSec=0
# `systemctl stop` sends SIGTERM: the run stops its workers at their next
# checkpoint and exits 1 within ~20s (15s grace for a worker stuck in an embed
# read, see src/indexer/stop.py). 60s leaves margin before systemd SIGKILLs it.
TimeoutStopSec=60
# Append to the relocated reindex log (logrotate stanza covers /var/log/odoo-semantic/*.log).
StandardOutput=append:/var/log/odoo-semantic/odoo-semantic-reindex.log
StandardError=append:/var/log/odoo-semantic/odoo-semantic-reindex.log
