# odoo-semantic-backup.service — systemd oneshot unit cho nightly backup
# Đặt tại: /etc/systemd/system/odoo-semantic-backup.service
# Sau khi copy:
#   sudo systemctl daemon-reload
#   sudo systemctl enable odoo-semantic-backup.timer
#   sudo systemctl start odoo-semantic-backup.timer
#
# Canonical layout = ADR-0027 (system-user `odoo-semantic`, app dir
# /home/odoo-semantic/odoo-semantic-mcp, config dir /home/odoo-semantic/etc).
# Operators on non-canonical layouts use drop-in overrides — see
# docs/deploy/install-runbook.md.
#
# IMPORTANT: the backup output directory must be owned by the service user.
# Create it (or fix ownership if migrating from a personal-user deployment):
#   sudo mkdir -p /var/backups/odoo-semantic
#   sudo chown odoo-semantic:odoo-semantic /var/backups/odoo-semantic
#   sudo chmod 0750 /var/backups/odoo-semantic
# Without this, the unit fails with `PermissionError: [Errno 13]` on first run
# (issue #139).
#
# Resilience (mirrors osm-ttl-cleanup.service, issue #142): `Requires=docker.service`
# alone only orders boot — it does NOT wait for the DB containers to become
# ready. If the timer fires while a container is mid-startup (host reboot,
# docker daemon restart), a bare backup would fail-fast. The ExecStartPre poll
# below waits up to 60s for Postgres readiness; Restart=on-failure + StartLimit
# then retry the whole oneshot (covering Neo4j-not-ready too — the backup CLI
# touches both Postgres and Neo4j, and a not-ready Neo4j surfaces as a failed
# attempt that the retry layer absorbs).

[Unit]
Description=OSM nightly backup
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# Retry budget: at most 3 starts within a 30-min window. Wider than
# osm-ttl-cleanup's 10-min window because a backup attempt itself can run for
# several minutes on a mature DB, so the retry spacing must not exhaust the
# window prematurely.
StartLimitBurst=3
StartLimitIntervalSec=1800
OnFailure=osm-alert@%n

[Service]
Type=oneshot
# A backup takes ~13 min (2026-10). Bound one attempt so a hung export cannot
# hold back odoo-semantic-reindex.service, which is ordered After= this unit and
# would otherwise wait for it without limit (a oneshot's default start timeout
# is infinite). A timed-out attempt counts as a failure: Restart=on-failure and
# OnFailure= apply as for any other failure.
TimeoutStartSec=1h
# Never back up while an index run writes: Neo4j is exported online, so a
# backup taken while a run writes holds a graph and a PostgreSQL that disagree.
# The reindex's After= only waits for a backup start job that exists when the
# reindex starts; in the RestartSec gap after a failed attempt there is none, so
# the reindex starts and the restarted backup would run beside it. An index run
# started from the Web UI (python -m src.indexer index-repo ... --job-id N,
# src/web_ui/helpers/subprocess_runner.py), a reembed-stubs, index-core or
# seed-patterns job is no systemd unit at all. This check refuses the attempt
# in all those cases:
#   - odoo-semantic-reindex.service is activating (a running oneshot; not
#     counted by `systemctl is-active`, hence ActiveState), active, reloading
#     or deactivating;
#   - a process of this unit's user runs `python -m src.indexer` with a
#     writing subcommand. The pattern is anchored on the interpreter (the
#     command line starts with .../python), and `src[.]indexer` cannot match
#     this shell's own command line, which holds the bracket text.
# Fail-closed: when systemctl or pgrep fails, a running index cannot be ruled
# out, so the attempt is refused too (an inconsistent bundle is silent, a
# missed backup is mailed). Exit 255 (not 1) on purpose: 1-254 would SKIP the
# unit silently (not failed, no OnFailure=), and a night without a backup must
# reach the admins. 255 fails the attempt: the journal line says why, and
# OnFailure= mails it. Restart=on-failure retries it 30s later; with the index
# still running the retries end in start-limit-hit (StartLimitBurst=3 within
# StartLimitIntervalSec=1800, within ~2 min), so after the index run ends:
# `sudo systemctl reset-failed odoo-semantic-backup.service` then
# `sudo systemctl start odoo-semantic-backup.service` (backup-runbook.md).
ExecCondition=/bin/sh -c '\
  why="a backup during it would export a graph and a PostgreSQL that disagree; start the backup again after it ends"; \
  state=$$(systemctl show --property=ActiveState --value odoo-semantic-reindex.service) \
    || { echo "odoo-semantic-backup: not started, systemctl could not read odoo-semantic-reindex.service, so a running index cannot be ruled out" >&2; exit 255; }; \
  case "$$state" in activating|active|reloading|deactivating) \
    echo "odoo-semantic-backup: not started, odoo-semantic-reindex.service is $$state ($$why)" >&2; exit 255;; esac; \
  pids=$$(pgrep -u "$$(id -u)" -f -- "^[^ ]*python[0-9.]* -m src[.]indexer (index-repo|index-core|reembed-stubs|seed-patterns)( |$$)"); rc=$$?; \
  case "$$rc" in \
    0) echo "odoo-semantic-backup: not started, an index run is running (pid $$(echo $$pids), e.g. started from the Web UI; $$why)" >&2; exit 255;; \
    1) exit 0;; \
    *) echo "odoo-semantic-backup: not started, pgrep failed (exit $$rc), so a running index cannot be ruled out" >&2; exit 255;; \
  esac'
User=odoo-semantic
Group=odoo-semantic
WorkingDirectory=/home/odoo-semantic/odoo-semantic-mcp
Environment="ODOO_SEMANTIC_CONF=/home/odoo-semantic/etc/odoo-semantic.conf"
# ADR-0027 §4: /var/tmp (disk-backed) for backup staging — /tmp is tmpfs on
# many hosts and a multi-GB pg_dump + tar will OOM-kill the worker.
Environment="TMPDIR=/var/tmp"
Environment="BACKUP_DIR=/var/backups/odoo-semantic"
EnvironmentFile=-/home/odoo-semantic/odoo-semantic-mcp/.env
# FERNET_KEY for the opt-in --bundle-passphrase-env DR bundle (fernet.enc, ADR-0018)
# via systemd credential store — see odoo-semantic-webui.service + deploy.md §12 (WI-7).
# The nightly bundle does NOT use FERNET; this only feeds passphrase-bundle runs.
# PREREQUISITE: /etc/credstore/FERNET_KEY must exist or this oneshot hard-fails at
# startup (243/CREDENTIALS) — the LoadCredential source is set up before ExecStart
# regardless of whether the run reads FERNET.
LoadCredential=FERNET_KEY:/etc/credstore/FERNET_KEY
# Pre-flight: wait up to 60s for Postgres to be ready (mirrors osm-ttl-cleanup,
# issue #142). Exits non-zero on timeout → triggers Restart= below instead of
# a hard fail. Override container name via $POSTGRES_CONTAINER in .env.
ExecStartPre=/bin/sh -c 'timeout 60 sh -c "until docker exec ${POSTGRES_CONTAINER:-odoo-semantic-mcp-postgres-1} pg_isready -U odoo_semantic -d odoo_semantic >/dev/null 2>&1; do sleep 2; done"'
ExecStart=/bin/sh -c 'exec /home/odoo-semantic/.venv/odoo-semantic-mcp/bin/python -m src.cli backup --output ${BACKUP_DIR}/osm-$(date +%%Y%%m%%d-%%H%%M%%S).tar.gz'
Restart=on-failure
RestartSec=30s
StandardOutput=journal
StandardError=journal

# Security hardening (oneshot still benefits from these)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
# NOTE: ProtectSystem=strict mounts the ENTIRE filesystem read-only except
# /dev,/proc,/sys (NOT just /usr,/boot,/etc — that is ProtectSystem=full). So
# both carve-outs below are REQUIRED, not redundant: the backup CLI writes the
# final archive to BACKUP_DIR and stages the pg_dump intermediate in TMPDIR.
ReadWritePaths=/var/backups/odoo-semantic
ReadWritePaths=/var/tmp
