# osm-alert@.service - mail the OSM admins when a unit fails (OnFailure=, #383)
# Place at: /etc/systemd/system/osm-alert@.service
#
# Hook: every OSM unit has `OnFailure=osm-alert@%n`, so when
# `odoo-semantic-reindex.service` fails systemd starts
# `osm-alert@odoo-semantic-reindex.service` (`%i` = `odoo-semantic-reindex`).
# Spell it `osm-alert@%n` everywhere (the notifier also accepts a trailing
# `.service` in the instance).
#
# What it does: `python -m src.ops.alert_notify` writes the journal line
# `osm-alert: unit=<u> state=failed host=<h> ...` (journalctl -u 'osm-alert@*')
# and mails every active Web UI admin with an email (webui_users.is_admin AND
# is_active, read from PostgreSQL at send time). The mail holds the unit, host,
# exit status, the last 60 lines of the unit's output (its append: log file,
# else its journal), the `Lifecycle needs attention` block when this run wrote
# one, and a runbook pointer; secrets are redacted. The same alert (unit, exit
# status, attention block or else the normalized last error line) is mailed
# once per OSM_ALERT_REPEAT_HOURS (20, under the 24h timer period), at most
# OSM_ALERT_MAX_PER_HOUR (6) mails an hour; what the cap holds is listed in the
# next mail. Database down: the last admin list cached in
# /var/lib/osm-alert/admins.json (if not older than
# OSM_ALERT_ADMIN_CACHE_MAX_DAYS, 7; the nightly reindex refreshes it) plus
# OSM_ALERT_FALLBACK_TO.
# Full description: docs/deploy/db-tier-operations.md section "Alert wiring".
#
# Credentials: it runs as odoo-semantic and reads the SAME env files as the Web
# UI (the SES SMTP_* settings and the owner PG_DSN already live there, so no
# new secret is minted or copied). /home/odoo-semantic/etc/alert.env is for the
# OSM_ALERT_* knobs only (optional, 0600 odoo-semantic). No FERNET_KEY.
#
# Smoke test (a real mail must arrive; `dummy` is not a unit, so it is a test
# alert that skips the dedupe):
#   sudo systemctl start osm-alert@dummy.service
#   journalctl -u osm-alert@dummy.service --no-pager | tail
# Expect `osm-alert: unit=dummy state=failed ...` then
# `osm-alert: dummy.service alert mailed to N recipient(s) ...`.

[Unit]
Description=OSM alert hook for %i
# No OnFailure= here: a failing alert must never fan out into more alerts.

[Service]
Type=oneshot
User=odoo-semantic
Group=odoo-semantic
# Read the journal of the failed unit (units without a log file).
SupplementaryGroups=systemd-journal
WorkingDirectory=/home/odoo-semantic/odoo-semantic-mcp
Environment="ODOO_SEMANTIC_CONF=/home/odoo-semantic/etc/odoo-semantic.conf"
# Same files, same order as odoo-semantic-webui.service (PG_DSN, SMTP_*), then
# the optional OSM_ALERT_* overrides.
EnvironmentFile=-/home/odoo-semantic/odoo-semantic-mcp/.env
EnvironmentFile=-/home/odoo-semantic/etc/webui.env
EnvironmentFile=-/home/odoo-semantic/etc/alert.env
# Dedupe state + last known admin list: /var/lib/osm-alert ($STATE_DIRECTORY).
StateDirectory=osm-alert
StateDirectoryMode=0700
ExecStart=/home/odoo-semantic/.venv/odoo-semantic-mcp/bin/python -m src.ops.alert_notify --unit %i
# Worst case (src/ops/alert_notify.py constants, checked by a test): 4
# systemctl/journalctl reads x 15s + DB 5s connect + 5s statement + state lock
# wait 2 x 20s + the whole SMTP send 45s = 155s, below this.
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal
# The notifier exits 0 whatever happens; belt-and-braces so the alert unit
# itself never lands in failed state.
SuccessExitStatus=0 1

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
